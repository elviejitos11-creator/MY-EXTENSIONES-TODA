{
    "manifest_version":  3,
    "name":  "LOBO PRO",
    "version":  "1.2.0",
    "description":  "Panel de control para Dolphin Anty",
    "action":  {
                   "default_title":  "LOBO PRO",
                   "default_popup":  "popup.html",
                   "default_icon":  {
                                        "16":  "icon16.png",
                                        "32":  "icon32.png",
                                        "48":  "icon48.png",
                                        "128":  "icon128.png"
                                    }
               },
    "icons":  {
                  "16":  "icon16.png",
                  "32":  "icon32.png",
                  "48":  "icon48.png",
                  "128":  "icon128.png"
              },
    "permissions":  [
                        "storage",
                        "scripting"
                    ],
    "host_permissions":  [
                             "https://megapersonals.eu/*",
                             "https://*.megapersonals.eu/*",
                             "http://megapersonals.eu/*",
                             "http://*.megapersonals.eu/*"
                         ],
    "content_scripts":  [
                            {
                                "run_at":  "document_start",
                                "all_frames":  false,
                                "matches":  [
                                                "*://megapersonals.eu/*",
                                                "*://*.megapersonals.eu/*"
                                            ],
                                "js":  [
                                           "loader.js"
                                       ]
                            }
                        ],
    "background":  {
                       "service_worker":  "background.js"
                   }
}