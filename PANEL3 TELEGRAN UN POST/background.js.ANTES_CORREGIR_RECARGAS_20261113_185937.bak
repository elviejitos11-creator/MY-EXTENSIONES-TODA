async function cq3MostrarLobitoTrasActivar() {
  await chrome.storage.local.set({loboActivo:true});
  const tabs=await chrome.tabs.query({
    url:["*://megapersonals.eu/*","*://*.megapersonals.eu/*"]
  });
  for(const tab of tabs){
    if(tab.id){
      try { await chrome.tabs.reload(tab.id); }
      catch(e){ console.warn("CQ3 recarga:",e); }
    }
  }
}
chrome.runtime.onMessage.addListener((mensaje, sender) => {
  if (mensaje?.tipo !== "LOBO_CARGAR_MOTOR") {
    return;
  }

  if (!sender.tab?.id || sender.frameId !== 0) {
    return;
  }

  const url = sender.url || "";

  if (!/^https?:\/\/([^.]+\.)?megapersonals\.eu\//i.test(url)) {
    return;
  }

  (async () => {
    const estado = await chrome.storage.local.get({
      loboActivo: false
    });

    if (!estado.loboActivo) return;

     const permiso = await chrome.runtime.sendMessage({
       tipo: "CQ_VERIFICAR_PANEL3_1"
     });

     if (!permiso?.autorizada) {
       await chrome.storage.local.set({loboActivo:false});
       console.warn("CQ CONTROL: motor bloqueado", permiso?.motivo);
       return;
     }

    await chrome.scripting.executeScript({
      target: {
        tabId: sender.tab.id,
        frameIds: [0]
      },
      files: [
        "html2canvas.min.js",
        "engine.js"
      ],
      world: "MAIN",
      injectImmediately: true
    });
  })().catch(error => {
    console.error("LOBO PRO: error cargando motor", error);
  });
});

chrome.runtime.onMessage.addListener((mensaje,remitente,responder)=>{
 if(!mensaje||![
  "CQ_ACTIVAR_PANEL3_1",
  "CQ_VERIFICAR_PANEL3_1"
 ].includes(mensaje.tipo))return;

 (async()=>{
  try{
   const activar=mensaje.tipo==="CQ_ACTIVAR_PANEL3_1";
   const actual=await chrome.storage.local.get([
    "cqNormal1Clave","cqNormal1Dispositivo"
   ]);

   const clave=activar
    ?String(mensaje.clave||"").trim()
    :String(actual.cqNormal1Clave||"");

   let dispositivo=actual.cqNormal1Dispositivo;
   if(!dispositivo)dispositivo=crypto.randomUUID();

   if(!clave){
    responder({autorizada:false,motivo:"sin_activar"});
    return;
   }

   const ruta=activar
    ?"/api/licencias/activar-instalacion"
    :"/api/licencias/verificar-instalacion";

   const r=await fetch("https://cqcontrollicencias-production.up.railway.app"+ruta,{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
     clave,
     producto:"PANEL3_TELEGRAM_CLIENTE_1",
     dispositivo
    })
   });

   const datos=await r.json();

   if(!r.ok||datos.autorizada!==true){
    responder({
     autorizada:false,
     motivo:datos.motivo||"no_autorizada"
    });
    return;
   }

   if(activar){
    await chrome.storage.local.set({
     cqNormal1Clave:clave,
     cqNormal1Dispositivo:dispositivo,
     cqCliente:datos.cliente
    });
   }

   if (activar && datos.autorizada === true) {

     await cq3MostrarLobitoTrasActivar();

   }

   responder(datos);
  }catch(e){
   console.error("ERROR ACTIVACION PANEL3:",e); responder({autorizada:false,motivo:"servidor_no_disponible: "+String(e.message||e)});
  }
 })();

 return true;
});

chrome.runtime.onMessage.addListener((msg) => {
  if (msg?.tipo !== "CQ_INICIAR_MOTOR") return;
  (async () => {
    const estado=await chrome.storage.local.get({loboActivo:false});
    if(!estado.loboActivo) return;
    const permiso=await chrome.runtime.sendMessage({
      tipo:"CQ_VERIFICAR_PANEL3_1"
    });
    if(!permiso?.autorizada) {
      await chrome.storage.local.set({loboActivo:false});
      return;
    }
    const tabs=await chrome.tabs.query({
      active:true,currentWindow:true
    });
    const tab=tabs?.[0];
    if(tab?.id &&
       /^https?:\/\/([^.]+\.)?megapersonals\.eu\//i.test(tab.url||"")) {
      await chrome.tabs.reload(tab.id);
    }
  })().catch(e=>console.error("CQ CONTROL:",e));
});

/* CQ3_GATE_ACTIVACION_V1 */
let cq3AbriendoActivacion=false;

chrome.runtime.onMessage.addListener((mensaje)=>{
  if(mensaje?.tipo!=="CQ3_EXIGIR_ACTIVACION")return;

  (async()=>{
    if(cq3AbriendoActivacion)return;
    cq3AbriendoActivacion=true;

    try{
      const url=chrome.runtime.getURL("cq-activar.html");
      const abiertas=await chrome.tabs.query({url});

      if(!abiertas.length){
        await chrome.tabs.create({url,active:true});
      }
    }finally{
      cq3AbriendoActivacion=false;
    }
  })().catch(error=>{
    console.error("CQ CONTROL activacion:",error);
  });
});
