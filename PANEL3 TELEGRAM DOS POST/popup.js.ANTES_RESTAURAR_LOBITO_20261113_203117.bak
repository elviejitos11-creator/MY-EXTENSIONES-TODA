const estado = document.getElementById("status");
const conectar = document.getElementById("conectar");
const desconectar = document.getElementById("desconectar");

const TIPO = "CQ_VERIFICAR_PANEL3_2";
const CLAVE = "cqClave";
const ACTIVACION = "cq-activar.html";

function actualizar(activo) {
  estado.textContent = activo ? "CONECTADO" : "DESCONECTADO";
  estado.style.color = activo ? "#4ade80" : "#fb7185";
  conectar.disabled = activo;
  desconectar.disabled = !activo;
}

async function abrirActivacion() {
  await chrome.tabs.create({
    url: chrome.runtime.getURL(ACTIVACION)
  });
}

async function verificar() {
  const permiso = await chrome.runtime.sendMessage({tipo:TIPO});
  return permiso?.autorizada === true;
}

async function bloquear() {
  await chrome.storage.local.set({loboActivo:false});
  actualizar(false);
}

async function iniciar() {
  actualizar(false);
  conectar.disabled = true;

  try {
    const datos = await chrome.storage.local.get([
      CLAVE, "loboActivo"
    ]);

    if (!datos[CLAVE]) {
      await bloquear();
      await abrirActivacion();
      return;
    }

    if (!(await verificar())) {
      await bloquear();
      estado.textContent = "LICENCIA REQUERIDA";
      return;
    }

    actualizar(datos.loboActivo === true);
  } catch (e) {
    await bloquear();
    estado.textContent = "SIN AUTORIZACION";
  }
}

conectar.addEventListener("click", async () => {
  conectar.disabled = true;

  try {
    const datos = await chrome.storage.local.get([CLAVE]);

    if (!datos[CLAVE] || !(await verificar())) {
      await bloquear();
      await abrirActivacion();
      return;
    }

    await chrome.storage.local.set({loboActivo:true});
    actualizar(true);

    // CQ3_INICIO_DIRECTO_SEGURO_V1
    // Ejecuta el cargador original sin recargar la pagina.
    // loader.js verifica la licencia antes de solicitar el motor.
    const cqTabs = await chrome.tabs.query({
      active: true,
      currentWindow: true
    });

    const cqTab = cqTabs?.[0];

    if (
      cqTab?.id &&
      /^https?:\/\/([^.]+\.)?megapersonals\.eu\//i.test(cqTab.url || "")
    ) {
      await chrome.scripting.executeScript({
        target: {
          tabId: cqTab.id,
          frameIds: [0]
        },
        files: ["loader.js"]
      });
    }

    const tabs = await chrome.tabs.query({
      active:true,currentWindow:true
    });

    const tab = tabs?.[0];
    if (tab?.id &&
      /^https?:\/\/([^.]+\.)?megapersonals\.eu\//i.test(tab.url||"")) {

    }
  } catch (e) {
    await bloquear();
    alert("No se pudo verificar la licencia de CQ CONTROL.");
  } finally {
    if (estado.textContent !== "CONECTADO") {
      conectar.disabled = false;
    }
  }
});

desconectar.addEventListener("click", async () => {
  await bloquear();
});

void iniciar();