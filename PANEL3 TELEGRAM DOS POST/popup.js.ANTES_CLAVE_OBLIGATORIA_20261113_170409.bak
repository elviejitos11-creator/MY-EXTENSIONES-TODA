const estado = document.getElementById("status");
const conectar = document.getElementById("conectar");
const desconectar = document.getElementById("desconectar");

function actualizar(activo) {
  estado.textContent = activo ? "CONECTADO" : "DESCONECTADO";
  estado.style.color = activo ? "#4ade80" : "#fb7185";
  conectar.disabled = activo;
  desconectar.disabled = !activo;
}

actualizar(false);

(async () => {
  try {
    const datos = await chrome.storage.local.get({
      loboActivo: false
    });

    const permiso = await chrome.runtime.sendMessage({
      tipo: "CQ_VERIFICAR_PANEL3_2"
    });

    if (!permiso || permiso.autorizada !== true) {
      await chrome.storage.local.set({loboActivo:false});
      actualizar(false);
      return;
    }

    actualizar(datos.loboActivo === true);
  } catch (e) {
    await chrome.storage.local.set({loboActivo:false});
    actualizar(false);
  }
})();

conectar.addEventListener("click", async () => {
  conectar.disabled = true;
  try {
    const permiso = await chrome.runtime.sendMessage({
      tipo: "CQ_VERIFICAR_PANEL3_2"
    });

    if (!permiso?.autorizada) {
      await chrome.storage.local.set({loboActivo:false});
      actualizar(false);
      alert("CQ CONTROL: licencia no autorizada. " +
        (permiso?.motivo || "Activa tu licencia primero."));
      return;
    }

    await chrome.storage.local.set({loboActivo:true});
    actualizar(true);

    const tabs = await chrome.tabs.query({
      active:true,currentWindow:true
    });
    const tab=tabs?.[0];
    if (tab?.id &&
        /^https?:\/\/([^.]+\.)?megapersonals\.eu\//i.test(tab.url||"")) {
      await chrome.tabs.reload(tab.id);
    }
  } catch(e) {
    await chrome.storage.local.set({loboActivo:false});
    actualizar(false);
    alert("No se pudo verificar la licencia.");
  }
});

desconectar.addEventListener("click", () => {
  chrome.storage.local.set({ loboActivo: false }, () => {
    actualizar(false);
  });
});